      "\t// 1. 分解：找到中点，递归求解左右两半的最小距离",
      "\tint mid = l + (r - l) / 2;",
      "\tdouble d = min(_closestPair(pts, l, mid), _closestPair(pts, mid + 1, r));",
      "\t",
      "\t// 2. 合并：收集距离中线 X 轴距离小于 d 的点",
      "\tvector<Point> strip;",
