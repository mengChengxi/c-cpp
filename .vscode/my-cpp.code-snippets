      "\t}",
      "\t",
      "\tdouble max_dist_sq = 0;",
      "\tint j = 2; // 最远点指针初始化",
      "\t",
      "\t// 遍历凸包的每一条边 i -> i+1",
      "\tfor (int i = 0; i < n; i++) {",
      "\t\t// 取当前边",
      "\t\tPoint a = hull[i];",
      "\t\tPoint b = hull[(i + 1) % n];",
