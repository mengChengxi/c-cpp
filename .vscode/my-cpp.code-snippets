      " * @return vector<int> 返回所有匹配成功时的起始下标（0-based 索引）",
      " */",
      "vector<int> kmp_search(const string& text, const string& pattern) {",
      "    vector<int> matches;",
      "    if (pattern.empty()) return matches;",
