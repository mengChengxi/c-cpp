      "\t\twhile (sgn(cross(b - a, hull[(j + 1) % n] - a) - ",
      "\t\t           cross(b - a, hull[j] - a)) > 0) {",
      "\t\t\tj = (j + 1) % n; // j 指针逆时针往前走",
