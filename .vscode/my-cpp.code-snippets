        "    vector<bool> vis;",
        "    vector<int> order;",
        "    vector<int> scc;",
        "",
        "    Kosaraju(int _n) : ",
        "        n(_n), ",
        "        scc_cnt(0), ",
        "        adj(_n + 1),",
        "        rev_adj(_n + 1), ",
        "        vis(_n + 1, false), ",
        "        scc(_n + 1, 0) {}",
        "",
