      "\tPoint operator + (const Point &b) const { return Point(x + b.x, y + b.y); }",
      "\tPoint operator - (const Point &b) const { return Point(x - b.x, y - b.y); }",
      "\tPoint operator * (const double &k) const { return Point(x * k, y * k); }",
      "\tPoint operator / (const double &k) const { return Point(x / k, y / k); }",
      "\tbool operator == (const Point &b) const {",
      "\t\treturn sgn(x - b.x) == 0 && sgn(y - b.y) == 0;",
      "\t}",
      "};",
      "typedef Point Vector;",
      "",
