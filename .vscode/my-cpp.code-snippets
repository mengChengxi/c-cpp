      "Point getIntersect(HLine l1, HLine l2) {",
      "\tVector u = l1.s - l2.s, v = l1.e - l1.s, w = l2.e - l2.s;",
      "\tdouble t = cross(w, u) / cross(v, w);",
      "\treturn l1.s + v * t;",
      "}",
      "",
      "// 半平面交核心逻辑，返回围成凸多边形的顶点集合",
      "vector<Point> halfPlaneIntersection(vector<HLine>& lines) {",
      "\tint n = lines.size();",
      "\tsort(lines.begin(), lines.end(), cmpHLine);",
      "\t",
      "\t// 去重：极角相同的直线，只保留最左侧的一条",
      "\tint m = 1;",
