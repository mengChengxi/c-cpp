      "    memset(low, 0, (n + 1) * sizeof(int));",
      "    memset(belong, 0, (n + 1) * sizeof(int));",
      "    memset(in_stack, 0, (n + 1) * sizeof(bool));",
      "    timer = top = scc_cnt = 0;",
      "    sccs.clear();",
      "    for (int i = 0; i <= n; i++) adj[i].clear();",
      "",
      "    // TODO: 建有向图逻辑...",
      "",
      "    for (int i = 1; i <= n; i++) {",
      "        if (!dfn[i]) tarjan_scc(i);",
      "    }",
      "}"
