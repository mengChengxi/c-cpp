            "}",
            "",
            "bool bfs(int S, int T, int n) {",
            "    for (int i = 0; i <= n; i++) {",
            "        level[i] = -1;",
            "        cur[i] = 0;",
            "    }",
            "    ",
            "    std::queue<int> q;",
            "    level[S] = 0;",
            "    q.push(S);",
            "    ",
            "    while (!q.empty()) {",
            "        int u = q.front();",
            "        q.pop();",
            "        ",
            "        for (int i = 0; i < adj[u].size(); i++) {",
            "            Edge &e = adj[u][i];",
            "            if (e.cap > 0 && level[e.to] == -1) {",
