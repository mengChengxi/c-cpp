      "\treturn max(a.x, b.x) >= min(c.x, d.x) &&",
      "\t       max(c.x, d.x) >= min(a.x, b.x) &&",
      "\t       max(a.y, b.y) >= min(c.y, d.y) &&",
      "\t       max(c.y, d.y) >= min(a.y, b.y);",
      "}",
      "",
      "// 跨立实验：判断线段 ab 和 cd 是否相交 (包含端点相交的非规范相交)",
      "bool segmentIntersection(Point a, Point b, Point c, Point d) {",
      "\t// 1. 快速排斥",
      "\tif (!quickReject(a, b, c, d)) return false;",
      "\t// 2. 跨立实验",
      "\tint c1 = sgn(cross(b - a, c - a));",
      "\tint c2 = sgn(cross(b - a, d - a));",
      "\tint c3 = sgn(cross(d - c, a - c));",
      "\tint c4 = sgn(cross(d - c, b - c));",
      "\t// 互相跨立才算相交 (一正一负相乘 <= 0)",
      "\treturn c1 * c2 <= 0 && c3 * c4 <= 0; ",
