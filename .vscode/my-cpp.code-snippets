      " */",
      "vector<int> compute_pi(const string& pattern) {",
      "    int m = pattern.length();",
      "    vector<int> pi(m);",
      "    for (int i = 1, j = 0; i < m; i++) {",
      "        while (j > 0 && pattern[i] != pattern[j]) {",
      "            j = pi[j - 1]; // 失配时，跳到上一个可能的最长前缀位置",
      "        }",
      "        if (pattern[i] == pattern[j]) {",
      "            j++;",
      "        }",
      "        pi[i] = j;",
      "    }",
      "    return pi;",
      "}",
      "",
      "/**",
