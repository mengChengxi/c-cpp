      "class FenwickTree {",
      "private:",
      "    vector<long long> tree; // 使用 long long 防爆 int 越界",
      "    int n;",
      "    // 核心位运算内部封装：提取 x 二进制中的最低位 1",
      "    inline int lowbit(int x) {",
      "        return x & (-x);",
      "    }",
      "public:",
      "    // ==========================",
      "    // =====    构造函数区    =====",
