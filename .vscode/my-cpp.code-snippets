      "vector<pair<int, int>> bridges;",
      "",
      "void tarjan_ebcc(int u, int fa) {",
      "    dfn[u] = low[u] = ++timer;",
      "    st[++top] = u;",
      "",
      "    for (int v : adj[u]) {",
      "        if (v == fa) continue; // 绝不走回头路",
