    "Min-Cost Max-Flow (SPFA)": {
        "prefix": "network_mcmf",
        "body": [
            "// 【MCMF 最小费用最大流】",
            "const long long INF = 1e18;",
            "const int MAXN = 100005;",
            "",
            "struct Edge {",
            "    int to;",
            "    long long cap;",
            "    long long cost;",
            "    int rev_idx;",
            "    bool is_forward;",
            "};",
            "",
            "std::vector<Edge> adj[MAXN];",
            "long long dist[MAXN];",
            "bool in_queue[MAXN];",
            "int pre_node[MAXN];",
            "int pre_edge[MAXN];",
            "long long min_cost = 0;",
            "long long max_flow = 0;",
            "",
            "void init_mcmf(int n) {",
            "    min_cost = 0;",
            "    max_flow = 0;",
            "    for (int i = 0; i <= n; i++) {",
            "        adj[i].clear();",
            "    }",
            "}",
            "",
            "void add_edge(int u, int v, long long cap, long long cost) {",
            "    adj[u].push_back({v, cap, cost, (int)adj[v].size(), true});",
            "    adj[v].push_back({u, 0, -cost, (int)adj[u].size() - 1, false});",
            "}",
            "",
            "bool spfa(int S, int T, int n) {",
            "    for (int i = 0; i <= n; i++) {",
            "        dist[i] = INF;",
            "        in_queue[i] = false;",
            "    }",
            "    std::queue<int> q;",
            "    dist[S] = 0;",
            "    q.push(S);",
            "    in_queue[S] = true;",
            "    ",
            "    while (!q.empty()) {",
            "        int u = q.front();",
            "        q.pop();",
            "        in_queue[u] = false;",
            "        ",
            "        for (int i = 0; i < adj[u].size(); i++) {",
            "            Edge &e = adj[u][i];",
            "            if (e.cap > 0 && dist[u] + e.cost < dist[e.to]) {",
            "                dist[e.to] = dist[u] + e.cost;",
            "                pre_node[e.to] = u;",
            "                pre_edge[e.to] = i;",
            "                ",
            "                if (!in_queue[e.to]) {",
            "                    q.push(e.to);",
            "                    in_queue[e.to] = true;",
            "                }",
            "            }",
            "        }",
            "    }",
            "    return dist[T] != INF;",
            "}",
            "",
            "void update_flow(int S, int T) {",
            "    long long flow = INF;",
            "    int curr = T;",
            "    ",
            "    while (curr != S) {",
            "        int p = pre_node[curr];",
            "        int idx = pre_edge[curr];",
            "        flow = std::min(flow, adj[p][idx].cap);",
            "        curr = p;",
            "    }",
            "    ",
            "    curr = T;",
            "    while (curr != S) {",
            "        int p = pre_node[curr];",
            "        int idx = pre_edge[curr];",
            "        ",
            "        Edge &e = adj[p][idx];",
            "        Edge &rev_e = adj[curr][e.rev_idx];",
            "        ",
            "        e.cap -= flow;",
            "        rev_e.cap += flow;",
            "        curr = p;",
            "    }",
            "    max_flow += flow;",
            "    min_cost += flow * dist[T];",
            "}",
            "",
            "void run_mcmf(int S, int T, int n) {",
            "    while (spfa(S, T, n)) {",
            "        update_flow(S, T);",
            "    }",
