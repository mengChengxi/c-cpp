      "",
      "const int N = 100005;",
      "vector<int> adj[N];",
      "int dfn[N], low[N], timer;",
      "int st[N], top;",
      "bool in_stack[N];",
      "int belong[N], scc_cnt;",
      "vector<vector<int>> sccs;",
      "",
      "void tarjan_scc(int u) {",
      "    dfn[u] = low[u] = ++timer;",
      "    st[++top] = u;",
      "    in_stack[u] = true;",
      "",
      "    for (int v : adj[u]) {",
      "        if (!dfn[v]) {",
      "            tarjan_scc(v);",
      "            low[u] = min(low[u], low[v]);",
      "        } else if (in_stack[v]) {",
      "            low[u] = min(low[u], dfn[v]);",
      "        }",
      "    }",
      "",
      "    if (dfn[u] == low[u]) {",
      "        scc_cnt++;",
      "        vector<int> current_scc;",
      "        int v;",
      "        do {",
      "            v = st[top--];",
      "            in_stack[v] = false;",
      "            belong[v] = scc_cnt;",
      "            current_scc.push_back(v);",
      "        } while (v != u);",
      "        sccs.push_back(current_scc);",
      "    }",
      "}",
      "",
      "void sample_scc(int n) {",
