      "        }",
      "    }",
      "",
      "    if (dfn[u] == low[u]) {",
      "        ebcc_cnt++;",
      "        int v;",
      "        do {",
      "            v = st[top--];",
      "            belong[v] = ebcc_cnt;",
      "        } while (v != u);",
      "    }",
