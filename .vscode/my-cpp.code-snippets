      "\t\t",
      "\t\t// j 停下时，说明 j 是离边 ab 最远的点",
      "\t\t// 此时最远点对可能产生于 (a, j) 或 (b, j)",
      "\t\tdouble d1 = dot(hull[j] - a, hull[j] - a); // a和j的距离平方",
      "\t\tdouble d2 = dot(hull[j] - b, hull[j] - b); // b和j的距离平方",
      "\t\t",
