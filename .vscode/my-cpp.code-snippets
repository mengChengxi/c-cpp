        "        adj[u].push_back(v);",
        "        rev_adj[v].push_back(u);",
        "    }",
        "",
        "    void dfs1(int u) {",
        "        vis[u] = true;",
        "        for (int v : adj[u]) {",
        "            if (!vis[v]) dfs1(v);",
        "        }",
        "        order.push_back(u);",
        "    }",
        "",
        "    void dfs2(int u) {",
        "        vis[u] = true;",
        "        scc[u] = scc_cnt;",
        "        for (int v : rev_adj[u]) {",
        "            if (!vis[v]) dfs2(v);",
        "        }",
        "    }",
        "",
        "    int build() {",
        "        for (int i = 1; i <= n; i++) {",
        "            if (!vis[i]) dfs1(i);",
